# Expected Microsoft Entra tenant ID for the authenticated Azure CLI account.
HUB_EVAL_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# Azure subscription ID where temporary validation resources may be created.
HUB_EVAL_AZURE_SUBSCRIPTION_ID=11111111-1111-1111-1111-111111111111
# Default Azure region for temporary resource groups and SQL servers.
HUB_EVAL_AZURE_LOCATION=eastus
# Existing test resource group to reuse, or leave blank together with the SQL server.
HUB_EVAL_EXISTING_RESOURCE_GROUP=
# Existing Entra-administered Azure SQL logical server to reuse, or leave blank together with the resource group.
HUB_EVAL_EXISTING_SQL_SERVER=
# Azure region used when the harness attempts to create an embedding account.
HUB_EVAL_EMBEDDING_LOCATION=eastus
# Whether the harness should attempt an Azure OpenAI Service deployment before using fixture vectors.
HUB_EVAL_PROVISION_EMBEDDING=true
# Existing Azure OpenAI Service endpoint, or leave blank to provision or use fixture vectors.
HUB_EVAL_EMBEDDING_ENDPOINT=
# Existing Azure OpenAI Service embedding deployment name, or leave blank with the endpoint.
HUB_EVAL_EMBEDDING_DEPLOYMENT=
# Existing embedding model output dimension, or leave blank with the endpoint.
HUB_EVAL_EMBEDDING_DIMENSION=
