{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Website: serve",
      "type": "shell",
      "command": "docker compose up --build --renew-anon-volumes",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "jekyll",
        "pattern": {
          "regexp": "^.*?(/workspace/[^:]+):(\\d+):\\s*(.*)$",
          "file": 1,
          "line": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Configuration file:.*",
          "endsPattern": ".*Server running\\.\\.\\..*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Website: stop",
      "type": "shell",
      "command": "docker compose down",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
